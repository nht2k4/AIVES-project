@page "{id:int}"
@model AIVES.Ass2.Razor.Pages.Accounts.EditModel
@{
    ViewData["Title"] = "Sửa tài khoản";
}
<a asp-page="Index" class="small">Quay lại danh sách tài khoản</a>
<div class="mt-2 mb-4">
    <h1 class="h3 mb-1">Cấp vai trò / sửa tài khoản</h1>
    <p class="text-muted mb-0">@Model.Account.Email</p>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Thông tin và vai trò</div>
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Input.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label"></label>
                        <input asp-for="Input.FullName" class="form-control" />
                        <span asp-validation-for="Input.FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.Role" class="form-label"></label>
                        <select asp-for="Input.Role" asp-items="Html.GetEnumSelectList<AppRole>()" class="form-select"></select>
                        <span asp-validation-for="Input.Role" class="text-danger"></span>
                        <div class="form-text">Đổi từ "Chờ cấp quyền" sang vai trò khác chính là cấp quyền đăng nhập.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Khóa / mở khóa</div>
            <div class="card-body">
                <p class="mb-3">
                    @if (Model.Account.IsActive) { <span class="badge text-bg-success">Đang hoạt động</span> }
                    else { <span class="badge text-bg-secondary">Đã khóa</span> }
                </p>
                <form method="post" asp-page-handler="SetActive" asp-route-id="@Model.Account.Id" asp-route-isActive="@(!Model.Account.IsActive)">
                    <button type="submit" class="btn @(Model.Account.IsActive ? "btn-outline-danger" : "btn-outline-success") w-100">
                        @(Model.Account.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                    </button>
                </form>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Đặt lại mật khẩu</div>
            <div class="card-body">
                <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Account.Id">
                    <div class="mb-3">
                        <label asp-for="Reset.NewPassword" class="form-label"></label>
                        <input asp-for="Reset.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Reset.NewPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-primary w-100">Đặt lại mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
