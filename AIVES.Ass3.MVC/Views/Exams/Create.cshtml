@model ExamCreateViewModel
@{
    ViewData["Title"] = "Tạo phiên thi";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
            <div>
                <h2 class="h4 mb-0">Tạo phiên thi vấn đáp</h2>
                <span class="text-muted small">Cấu hình thời gian, thông số phỏng vấn và danh sách sinh viên dự thi.</span>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SubjectId" class="form-label fw-semibold"></label>
                            <select asp-for="SubjectId" class="form-select">
                                <option value="">-- Chọn môn học --</option>
                                @foreach (var s in Model.Subjects)
                                {
                                    <option value="@s.Id">@s.Code - @s.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SubjectId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Thi vấn đáp Lần 1 - Block 5" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label fw-semibold"></label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control" min="@Model.MinimumStartTime" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                            <div class="form-text">Thời gian bắt đầu thí sinh đầu tiên (không chọn thời gian quá khứ).</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SlotMinutes" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="SlotMinutes" type="number" min="1" max="120" class="form-control" />
                                <span class="input-group-text">phút</span>
                            </div>
                            <span asp-validation-for="SlotMinutes" class="text-danger small"></span>
                            <div class="form-text">Thời lượng dành cho mỗi thí sinh (1 - 120 phút).</div>
                        </div>
                    </div>

                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold text-primary mb-3">Cấu hình câu hỏi & phỏng vấn AI</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="MainQuestionCount" class="form-label"></label>
                                    <input asp-for="MainQuestionCount" type="number" min="1" max="20" class="form-control" />
                                    <span asp-validation-for="MainQuestionCount" class="text-danger small"></span>
                                    <div class="form-text">Số câu chính phân bổ tự động cho mỗi thí sinh (1 - 20).</div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="AnswerSeconds" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="AnswerSeconds" type="number" min="10" max="600" class="form-control" />
                                        <span class="input-group-text">giây</span>
                                    </div>
                                    <span asp-validation-for="AnswerSeconds" class="text-danger small"></span>
                                    <div class="form-text">Thời gian thí sinh suy nghĩ và trả lời mỗi câu (10 - 600s).</div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="MaxFollowUps" class="form-label"></label>
                                    <input asp-for="MaxFollowUps" type="number" min="0" max="40" class="form-control" />
                                    <span asp-validation-for="MaxFollowUps" class="text-danger small"></span>
                                    <div class="form-text">Tổng số câu hỏi xoáy tối đa trong toàn bài thi (0 - 40).</div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="MaxFollowUpsPerQuestion" class="form-label"></label>
                                    <input asp-for="MaxFollowUpsPerQuestion" type="number" min="0" max="5" class="form-control" />
                                    <span asp-validation-for="MaxFollowUpsPerQuestion" class="text-danger small"></span>
                                    <div class="form-text">Số câu hỏi xoáy tối đa cho mỗi câu chính (0 - 5).</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="StudentList" class="form-label fw-semibold"></label>
                        <textarea asp-for="StudentList" rows="6" class="form-control font-monospace"
                                  placeholder="Mỗi dòng một sinh viên: MSSV; Họ tên&#10;Ví dụ:&#10;SE150001; Nguyễn Văn An&#10;SE150002; Trần Thị Bình"></textarea>
                        <span asp-validation-for="StudentList" class="text-danger small"></span>
                        <div class="form-text">
                            Định dạng: <code>MSSV; Họ tên</code> (ngăn cách bởi dấu chấm phẩy, dấu phẩy, khoảng trắng hoặc tab).
                            Lưu ý: Tất cả MSSV phải có tài khoản Sinh viên đã được tạo trước trong hệ thống.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Tạo phiên thi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
