@page
@model AIVES.Ass2.Razor.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Tài khoản";
    var roles = Html.GetEnumSelectList<AppRole>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Tài khoản</h1>
        <p class="text-muted mb-0">Cấp vai trò cho tài khoản mới đăng ký, khóa và đặt lại mật khẩu.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Tạo tài khoản</a>
</div>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label asp-for="Keyword" class="form-label">Từ khóa</label>
        <input asp-for="Keyword" class="form-control" placeholder="Họ tên hoặc email" />
    </div>
    <div class="col-md-3">
        <label asp-for="Role" class="form-label">Vai trò</label>
        <select asp-for="Role" asp-items="roles" class="form-select">
            <option value="">Tất cả vai trò</option>
        </select>
    </div>
    <div class="col-md-5 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>
<div id="account-list" data-live="accounts">
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Họ tên</th>
                        <th scope="col">Email</th>
                        <th scope="col">Vai trò</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ngày tạo</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Accounts.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có tài khoản phù hợp.</td></tr>
                }
                @foreach (var a in Model.Accounts)
                {
                    <tr class="@(a.IsActive ? "" : "table-secondary text-muted")">
                        <td class="fw-semibold">@a.FullName</td>
                        <td>@a.Email</td>
                        <td>
                            @if (a.Role == AppRole.Pending)
                            {
                                <span class="badge text-bg-warning">Chờ cấp quyền</span>
                            }
                            else
                            {
                                @TV4Ui.RoleName(a.Role)
                            }
                        </td>
                        <td>
                            @if (a.IsActive) { <span class="badge text-bg-success">Đang hoạt động</span> }
                            else { <span class="badge text-bg-secondary">Đã khóa</span> }
                        </td>
                        <td>@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-page="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <form method="post" asp-page-handler="SetActive" asp-route-id="@a.Id" asp-route-isActive="@(!a.IsActive)" asp-route-keyword="@Model.Keyword" asp-route-role="@Model.Role">
                                    <button type="submit" class="btn btn-sm @(a.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(a.IsActive ? "Khóa" : "Mở khóa")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
