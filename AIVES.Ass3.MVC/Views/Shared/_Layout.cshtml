@using AIVES.Business.Models
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AIVES</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">AIVES</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-2">
                        @if (User.IsInRole(Roles.Student))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MyExams" asp-action="Index">Bài thi của tôi</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Subjects" asp-action="Index">Môn học và phân công</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Accounts" asp-action="Index">Tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Exams" asp-action="Index">Phiên thi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Voices" asp-action="Index">Giọng đọc</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Lecturer))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MySubjects" asp-action="Index">Môn của tôi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Exams" asp-action="Index">Phiên thi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Voices" asp-action="Index">Giọng đọc</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Lecturer))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" href="/swagger" target="_blank">API</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3 text-light">
                        <span class="small">
                            @User.Identity.Name
                            @{
                                var roleName = User.IsInRole(Roles.Admin) ? "Quản trị viên"
                                    : User.IsInRole(Roles.Lecturer) ? "Giảng viên"
                                    : User.IsInRole(Roles.Student) ? "Sinh viên" : "Chờ cấp quyền";
                            }
                            <span class="badge text-bg-light ms-1">@roleName</span>
                        </span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-light">Đăng xuất</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="container small text-muted pb-4 border-top pt-3">
        AIVES · Hệ thống vấn đáp tự động bằng AI
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/live.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
