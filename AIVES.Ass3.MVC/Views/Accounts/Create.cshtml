@model AIVES.Ass3.MVC.ViewModels.AccountCreateViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
    var roles = Html.GetEnumSelectList<AppRole>().Where(i => i.Value != ((int)AppRole.Pending).ToString());
}
<a asp-action="Index" class="small">Quay lại danh sách tài khoản</a>
<div class="mt-2 mb-4"><h1 class="h3">Tạo tài khoản</h1></div>
<div class="card shadow-sm" style="max-width: 650px;">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="roles" class="form-select" id="roleSelect">
                    <option value="">Chọn vai trò</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="mb-4" id="studentCodeGroup">
                <label asp-for="StudentCode" class="form-label"></label>
                <input asp-for="StudentCode" class="form-control" placeholder="Ví dụ: SE180001" />
                <span asp-validation-for="StudentCode" class="text-danger"></span>
                <div class="form-text">Bắt buộc khi vai trò là Sinh viên.</div>
            </div>
            <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
