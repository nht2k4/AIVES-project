@page "{id:int}"
@model AIVES.Ass2.Razor.Pages.Subjects.DetailsModel
@{
    var s = Model.Detail.Subject;
    ViewData["Title"] = "Chi tiết " + s.Code;
    var lecturers = Model.Detail.AvailableLecturers.Select(l => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem($"{l.FullName} ({l.Email})", l.Id.ToString()));
}
<a asp-page="Index" class="small">Quay lại danh sách môn học</a>
<div class="mt-2 mb-4"><h1 class="h3 mb-1">@s.Code: @s.Name</h1>@if (!s.IsActive) { <span class="badge text-bg-secondary">Đã ngừng</span> }</div>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Giảng viên được phân công (@Model.Detail.AssignedLecturers.Count)</div>
            <div class="table-responsive"><table class="table align-middle mb-0">
                <thead class="table-light"><tr><th scope="col">Họ tên</th><th scope="col">Email</th><th scope="col">Ngày phân công</th><th scope="col">Thao tác</th></tr></thead>
                <tbody>
                @if (Model.Detail.AssignedLecturers.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Chưa có giảng viên được phân công.</td></tr>
                }
                @foreach (var l in Model.Detail.AssignedLecturers)
                {
                    <tr><td>@l.FullName @if (!l.IsActive) { <span class="badge text-bg-secondary">Đã khóa</span> }</td><td>@l.Email</td><td>@l.AssignedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><form method="post" asp-page-handler="Unassign" asp-route-id="@s.Id"><input type="hidden" name="lecturerId" value="@l.Id" /><button type="submit" class="btn btn-sm btn-outline-danger">Gỡ phân công</button></form></td>
                    </tr>
                }
                </tbody>
            </table></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Phân công giảng viên</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Assign" asp-route-id="@s.Id">
                    <label asp-for="LecturerId" class="form-label">Giảng viên</label>
                    <select asp-for="LecturerId" asp-items="lecturers" class="form-select"><option value="">Chọn giảng viên</option></select>
                    <span asp-validation-for="LecturerId" class="text-danger d-block mt-1"></span>
                    <button type="submit" class="btn btn-primary w-100 mt-3">Phân công</button>
                </form>
                @if (Model.Detail.AvailableLecturers.Count == 0) { <p class="small text-muted mt-3 mb-0">Không còn giảng viên đang hoạt động để phân công.</p> }
            </div>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Ngôn ngữ STT/TTS</div>
            <div class="card-body"><p>Nhận dạng giọng nói: <strong>@s.SttLanguage.ToLocaleCode()</strong></p><p>Đọc văn bản: <strong>@s.TtsLanguage.ToLocaleCode()</strong></p><a asp-page="/Language/Edit" asp-route-subjectId="@s.Id" class="btn btn-outline-primary w-100">Đổi ngôn ngữ</a></div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Ngân hàng câu hỏi</div>
            <div class="card-body"><p class="small text-muted">Thêm câu hỏi và chọn các câu đang dùng cho môn học.</p><a asp-page="/Exams/Questions" asp-route-subjectId="@s.Id" class="btn btn-outline-primary w-100">Quản lý câu hỏi</a></div>
        </div>
    </div>
</div>
