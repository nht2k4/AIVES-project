@using AIVES.Business.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AIVES</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f6f8fb; color: #20304a; }
        .navbar { background: #14335c; }
        .navbar-brand, .navbar .nav-link { color: #fff; }
        .navbar .nav-link:hover { color: #d4e4ff; }
        .card { border-color: #e1e7ef; border-radius: .75rem; overflow: hidden; }
        .card-header { padding: 1rem; }
        .table td, .table th { padding: .9rem 1rem; }
        .tv5-text { white-space: pre-wrap; overflow-wrap: anywhere; min-width: 180px; }
        .tv5-form { max-width: 660px; }
        .validation-summary-valid, .field-validation-valid { display: none; }
    </style>
</head>
<body>
    <nav class="navbar mb-4" aria-label="Điều hướng chính"><div class="container d-flex flex-wrap gap-3">
        <span class="navbar-brand fw-bold">AIVES</span>
        <div class="d-flex flex-wrap gap-3 me-auto">
            @if (User.IsInRole(Roles.Admin)) { <a asp-page="/Subjects/Index" class="nav-link">Môn học và phân công</a> }
            @if (User.IsInRole(Roles.Lecturer)) { <a asp-page="/MySubjects/Index" class="nav-link">Môn của tôi</a> }
        </div>
        <span class="text-white small">@User.Identity?.Name</span>
    </div></nav>
    <main class="container pb-5">
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="container small text-muted pb-4">AIVES · Hệ thống vấn đáp</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
