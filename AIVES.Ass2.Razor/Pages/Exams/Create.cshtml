@page
@model AIVES.Ass2.Razor.Pages.Exams.CreateModel
@{
    ViewData["Title"] = "Tạo phiên thi";
}

<a asp-page="Index" class="small">Quay lại danh sách phiên thi</a>
<h1 class="h3 mt-2 mb-4">Tạo phiên thi</h1>

@if (Model.Subjects.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Chưa có môn học đang mở mà bạn được phép tạo phiên thi. Vui lòng liên hệ quản trị viên.
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.SubjectId" class="form-label"></label>
                    <select asp-for="Input.SubjectId" class="form-select" required>
                        <option value="">Chọn môn học</option>
                        @foreach (var subject in Model.Subjects)
                        {
                            <option value="@subject.Id">@subject.Code — @subject.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.SubjectId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" maxlength="150" required />
                    <span asp-validation-for="Input.Title" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.StartTime" class="form-label"></label>
                    <input asp-for="Input.StartTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"
                           min="@Model.MinimumStartTime" class="form-control" required />
                    <span asp-validation-for="Input.StartTime" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SlotMinutes" class="form-label"></label>
                    <input asp-for="Input.SlotMinutes" type="number" min="1" max="120" class="form-control" required />
                    <span asp-validation-for="Input.SlotMinutes" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.MainQuestionCount" class="form-label"></label>
                    <input asp-for="Input.MainQuestionCount" type="number" min="1" max="20" class="form-control" required />
                    <span asp-validation-for="Input.MainQuestionCount" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.MaxFollowUps" class="form-label"></label>
                    <input asp-for="Input.MaxFollowUps" type="number" min="0" max="40" class="form-control" required />
                    <span asp-validation-for="Input.MaxFollowUps" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.MaxFollowUpsPerQuestion" class="form-label"></label>
                    <input asp-for="Input.MaxFollowUpsPerQuestion" type="number" min="0" max="5" class="form-control" required />
                    <span asp-validation-for="Input.MaxFollowUpsPerQuestion" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.AnswerSeconds" class="form-label"></label>
                    <input asp-for="Input.AnswerSeconds" type="number" min="10" max="600" class="form-control" required />
                    <span asp-validation-for="Input.AnswerSeconds" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.StudentList" class="form-label"></label>
                    <textarea asp-for="Input.StudentList" class="form-control" rows="7" required
                              aria-describedby="student-list-help" placeholder="SE001; Nguyễn Văn An"></textarea>
                    <div id="student-list-help" class="form-text">
                        Mỗi dòng một sinh viên theo dạng MSSV; Họ tên. Tối đa 200 sinh viên, không trùng MSSV.
                    </div>
                    <span asp-validation-for="Input.StudentList" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" disabled="@(Model.Subjects.Count == 0)">Tạo phiên thi</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
