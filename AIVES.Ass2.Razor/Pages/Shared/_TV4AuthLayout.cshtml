@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AIVES</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f6f8fb; color: #20304a; }
        .auth-card { max-width: 420px; border-color: #e1e7ef; border-radius: .75rem; }
        .validation-summary-valid, .field-validation-valid { display: none; }
    </style>
</head>
<body>
    <main class="container py-5 d-flex flex-column align-items-center">
        <h1 class="h3 mb-4">AIVES</h1>
        @if (TempData["Success"] is string success) { <div class="alert alert-success w-100 auth-card" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger w-100 auth-card" role="alert">@error</div> }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
