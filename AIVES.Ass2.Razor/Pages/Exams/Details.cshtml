@page "{id:int}"
@model AIVES.Ass2.Razor.Pages.Exams.DetailsModel
@{
    ViewData["Title"] = "Chi tiết phiên thi";
}

<a asp-page="Index" class="small">Quay lại danh sách phiên thi</a>
<div id="exam-detail" data-live="exam-@Model.Exam.Id" class="mt-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">@Model.Exam.Title</h1>
            <span class="badge @(Model.Exam.Status == ExamStatuses.Open ? "text-bg-success" : "text-bg-secondary")">
                @(Model.Exam.Status == ExamStatuses.Open ? "Đang mở" : "Đã đóng")
            </span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="SetOpen" asp-route-id="@Model.Exam.Id">
                <input type="hidden" name="open" value="@(Model.Exam.Status == ExamStatuses.Open ? "false" : "true")" />
                <button type="submit" class="btn btn-outline-primary">
                    @(Model.Exam.Status == ExamStatuses.Open ? "Đóng phiên thi" : "Mở phiên thi")
                </button>
            </form>
            @if (Model.CanReallocate)
            {
                <form method="post" asp-page-handler="Reallocate" asp-route-id="@Model.Exam.Id">
                    <button type="submit" class="btn btn-outline-secondary">Chọn lại bộ câu hỏi</button>
                </form>
            }
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    @if (!Model.CanReallocate)
    {
        <p class="text-muted">Đã có thí sinh bắt đầu thi, không thể chọn lại bộ câu hỏi.</p>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 text-muted">Môn học</h2>
                <div class="fw-semibold">@Model.Exam.SubjectCode — @Model.Exam.SubjectName</div>
                <a asp-page="Questions" asp-route-subjectId="@Model.Exam.SubjectId" class="small">Ngân hàng câu hỏi</a>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 text-muted">Lịch thi</h2>
                <div class="fw-semibold">@Model.Exam.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                <div>@Model.Exam.SlotMinutes phút / thí sinh</div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 text-muted">Thí sinh và câu hỏi</h2>
                <div>@Model.Exam.Participants.Count thí sinh · @Model.Exam.MainQuestionCount câu chính / người</div>
                <div>@Model.Exam.AnswerSeconds giây trả lời / câu</div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 text-muted">Câu hỏi đào sâu</h2>
                <div>Tối đa @Model.Exam.MaxFollowUps câu / thí sinh</div>
                <div>Tối đa @Model.Exam.MaxFollowUpsPerQuestion lượt / câu chính</div>
            </div></div>
        </div>
    </div>

    <h2 class="h5">Lịch thi và bộ câu hỏi</h2>
    @if (Model.Exam.Participants.Count == 0)
    {
        <div class="alert alert-info">Phiên thi chưa có thí sinh.</div>
    }
    else
    {
        <div class="card table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Lịch thi, câu hỏi và trạng thái từng thí sinh</caption>
                <thead class="table-light"><tr>
                    <th scope="col">MSSV</th><th scope="col">Họ tên</th>
                    <th scope="col">Khung giờ</th><th scope="col">Bộ câu hỏi</th><th scope="col">Trạng thái</th>
                </tr></thead>
                <tbody>
                @foreach (var participant in Model.Exam.Participants)
                {
                    <tr>
                        <td>@participant.StudentCode</td>
                        <td>@participant.FullName</td>
                        <td class="text-nowrap">
                            <div>@participant.SlotStart.ToString("dd/MM/yyyy HH:mm")</div>
                            <div>đến @participant.SlotEnd.ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                        <td><ol class="mb-0 ps-3">
                            @foreach (var question in participant.Questions)
                            {
                                <li>@question</li>
                            }
                        </ol></td>
                        <td>
                            @switch (participant.Status)
                            {
                                case ParticipantStatuses.Scheduled:
                                    <span class="badge text-bg-secondary">Chưa thi</span>
                                    break;
                                case ParticipantStatuses.InProgress:
                                    <span class="badge text-bg-warning">Đang thi</span>
                                    break;
                                case ParticipantStatuses.Completed:
                                    <span class="badge text-bg-success">Đã thi xong</span>
                                    break;
                                default:
                                    <span class="badge text-bg-light">@participant.Status</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
