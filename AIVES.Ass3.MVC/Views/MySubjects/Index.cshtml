@* TV5 - Ass3 - việc 5.2 *@
@model List<SubjectDto>
@{
    ViewData["Title"] = "Môn của tôi";
}

<div class="mb-4">
    <h1 class="h3">Môn của tôi</h1>
    <p class="text-muted mb-0">Các môn học bạn được phân công giảng dạy.</p>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mã môn</th>
                    <th scope="col">Tên môn</th>
                    <th scope="col">Nhận dạng (STT)</th>
                    <th scope="col">Đọc (TTS)</th>
                    <th scope="col">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Bạn chưa được phân công môn học nào.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr class="@(s.IsActive ? "" : "table-secondary text-muted")">
                        <td class="fw-semibold">
                            @s.Code
                            @if (!s.IsActive)
                            {
                                <span class="badge text-bg-secondary">Đã ngừng</span>
                            }
                        </td>
                        <td>@s.Name</td>
                        <td>@s.SttLanguage.ToLocaleCode()</td>
                        <td>@s.TtsLanguage.ToLocaleCode()</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Language" asp-action="Edit" asp-route-subjectId="@s.Id" class="btn btn-sm btn-outline-primary">Đổi ngôn ngữ</a>
                                <a asp-controller="Exams" asp-action="Questions" asp-route-subjectId="@s.Id" class="btn btn-sm btn-outline-secondary">Câu hỏi</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
