@* TV5 - Ass3 - việc 5.3: Bài thi của tôi *@
@model List<MyInterviewDto>
@{
    ViewData["Title"] = "Bài thi của tôi";
}

<div class="mb-4">
    <h1 class="h3">Bài thi của tôi</h1>
    <p class="text-muted mb-0">Các phiên thi vấn đáp có tên bạn (theo mã sinh viên của tài khoản).</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Chưa có phiên thi nào có tên bạn. Khi giảng viên thêm mã sinh viên của bạn vào một phiên thi, phiên đó sẽ hiện ở đây.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Phiên thi</th>
                        <th scope="col">Môn</th>
                        <th scope="col">Khung giờ</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var completed = e.Status == ParticipantStatuses.Completed;
                        var inProgress = e.Status == ParticipantStatuses.InProgress;
                        var closed = !e.SessionOpen && !completed;

                        var (label, badge) = completed ? ("Đã thi", "text-bg-success")
                            : closed ? ("Phiên thi đã đóng", "text-bg-secondary")
                            : inProgress ? ("Đang thi", "text-bg-warning")
                            : ("Sẵn sàng", "text-bg-primary");

                        <tr>
                            <td class="fw-semibold">@e.SessionTitle</td>
                            <td>@e.SubjectCode <span class="text-muted">· @e.SubjectName</span></td>
                            <td class="text-nowrap">
                                @e.SlotStart.ToString("dd/MM/yyyy")<br />
                                <span class="text-muted">@e.SlotStart.ToString("HH:mm") - @e.SlotEnd.ToString("HH:mm")</span>
                            </td>
                            <td><span class="badge @badge">@label</span></td>
                            <td>
                                @if (completed)
                                {
                                    <a asp-controller="Interview" asp-action="Transcript" asp-route-participantId="@e.ParticipantId"
                                       class="btn btn-sm btn-outline-secondary">Xem biên bản</a>
                                }
                                else if (!closed)
                                {
                                    <a asp-controller="Interview" asp-action="Room" asp-route-participantId="@e.ParticipantId"
                                       class="btn btn-sm btn-primary">@(inProgress ? "Tiếp tục thi" : "Vào phòng thi")</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
