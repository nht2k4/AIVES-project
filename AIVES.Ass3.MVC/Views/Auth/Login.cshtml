@model AIVES.Ass3.MVC.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm auth-card w-100">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Đăng nhập</h1>
                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Vào hệ thống</button>
                </form>
                <p class="mt-3 mb-0 text-center"><a asp-action="Register">Tạo tài khoản</a></p>
            </div>
        </div>
        <div class="small text-muted mt-4 p-3 bg-light rounded border">
            <p class="fw-semibold mb-2">Tài khoản mẫu</p>
            <ul class="mb-0 ps-3">
                <li><code>admin@fu.edu.vn</code> / <code>Admin@123</code> — Quản trị viên</li>
                <li><code>an.nv@fu.edu.vn</code> / <code>Lecturer@123</code> — Giảng viên</li>
                <li><code>binh.tt@fu.edu.vn</code> / <code>Lecturer@123</code> — Giảng viên</li>
                <li><code>moi.dangky@fu.edu.vn</code> / <code>Lecturer@123</code> — Chờ cấp quyền</li>
                <li><code>sv.a@fu.edu.vn</code> / <code>Student@123</code> — Sinh viên (SE180001)</li>
            </ul>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
