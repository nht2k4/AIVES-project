@model LanguageConfigViewModel
@{
    ViewData["Title"] = "Ngôn ngữ STT/TTS";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<h1 class="h3 mb-1">Ngôn ngữ STT/TTS</h1>
<p class="text-muted mb-4">@Model.SubjectCode: @Model.SubjectName</p>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" method="post" class="card border-0 shadow-sm card-body">
            <input type="hidden" asp-for="SubjectId" />
            <input type="hidden" asp-for="SubjectCode" />
            <input type="hidden" asp-for="SubjectName" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="SttLanguage" class="form-label"></label>
                <select asp-for="SttLanguage" asp-items="Html.GetEnumSelectList<AppLanguage>()" class="form-select"></select>
                <div class="form-text">Dùng khi chuyển câu trả lời bằng giọng nói của sinh viên thành văn bản.</div>
            </div>
            <div class="mb-3">
                <label asp-for="TtsLanguage" class="form-label"></label>
                <select asp-for="TtsLanguage" asp-items="Html.GetEnumSelectList<AppLanguage>()" class="form-select"></select>
                <div class="form-text">Dùng khi giám khảo AI đọc câu hỏi thành giọng nói.</div>
            </div>

            @if (Model.UpdatedAt.HasValue)
            {
                <p class="small text-muted">
                    Lần sửa gần nhất: @Model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") bởi @Model.UpdatedBy
                </p>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
                @if (isAdmin)
                {
                    <a asp-controller="Subjects" asp-action="Details" asp-route-id="@Model.SubjectId" class="btn btn-outline-secondary">Hủy</a>
                }
                else
                {
                    <a asp-controller="MySubjects" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                }
            </div>
        </form>
    </div>
</div>
