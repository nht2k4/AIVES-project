@{
    ViewData["Title"] = "Phòng thi vấn đáp AI";
    var participantId = ViewBag.ParticipantId;
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">
                    <span id="subject-badge" class="badge text-bg-light me-2">AIVES</span>
                    Phòng thi vấn đáp trực tuyến
                </h5>
                <span id="role-notice" class="badge text-bg-warning text-dark">Sinh viên dự thi</span>
            </div>
            <div class="card-body p-4">
                <!-- Thông báo quyền riêng tư -->
                <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                    <div class="small">
                        <strong>Ghi âm và quyền riêng tư:</strong>
                        Câu trả lời của bạn được <strong>ghi âm</strong> và lưu cùng văn bản nhận dạng (STT) để giảng viên nghe lại, đối chiếu khi chấm.
                        Chỉ <strong>giảng viên phụ trách môn và quản trị viên</strong> nghe được; ghi âm bị xóa cùng phiên thi.
                        Giọng nói được trình duyệt chuyển thành chữ (Chrome/Edge dùng dịch vụ nhận dạng của Google/Microsoft).
                        Bấm "Bắt đầu phỏng vấn" nghĩa là bạn đồng ý được ghi âm.
                    </div>
                </div>

                <!-- Màn hình chờ bắt đầu -->
                <div id="start-screen" class="text-center py-4">
                    <h4 class="fw-bold mb-3 text-primary">Sẵn sàng bước vào phần thi vấn đáp</h4>
                    <p class="text-muted mb-4">
                        Hệ thống AI sẽ đọc câu hỏi thành tiếng và nhận dạng câu trả lời của bạn qua micro.<br />
                        Bạn có thể nói hoặc gõ trực tiếp câu trả lời vào khung văn bản.
                    </p>
                    <button id="btn-start" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow">
                        Bắt đầu phỏng vấn
                    </button>
                    <div id="start-error" class="text-danger mt-3 d-none"></div>
                </div>

                <!-- Màn hình đang thi -->
                <div id="exam-screen" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <span id="question-badge" class="badge text-bg-primary fs-6 me-2">Câu chính 1/1</span>
                            <span id="followup-badge" class="badge text-bg-warning text-dark fs-6 d-none">Hỏi xoáy 1/2</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small">Thời gian còn lại:</span>
                            <span id="timer-box" class="badge fs-5 bg-secondary text-white font-monospace px-3 py-2">60s</span>
                        </div>
                    </div>

                    <!-- Nội dung câu hỏi -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body p-4">
                            <h5 class="text-muted small text-uppercase fw-semibold mb-2">Câu hỏi từ Giám khảo AI:</h5>
                            <div id="question-text" class="fs-5 fw-semibold text-dark">Đang tải câu hỏi...</div>
                            <div id="tts-status" class="small text-muted mt-2 fst-italic">Đang chuẩn bị giọng đọc...</div>
                        </div>
                    </div>

                    <!-- Khung trả lời -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label for="answer-box" class="form-label fw-bold mb-0">Câu trả lời của bạn:</label>
                            <span id="mic-status" class="badge text-bg-secondary">Micro đang tắt</span>
                        </div>
                        <textarea id="answer-box" class="form-control" rows="5" placeholder="Nhấp để gõ hoặc nói vào micro sau khi AI đọc xong..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <span class="text-muted small">
                            * Hết thời gian, hệ thống sẽ tự động nộp câu trả lời hiện tại.
                        </span>
                        <button id="btn-submit" class="btn btn-success btn-lg px-4 fw-bold">
                            Nộp câu trả lời
                        </button>
                    </div>
                    <div id="submit-error" class="text-danger mt-2 text-end d-none"></div>
                </div>

                <!-- Màn hình kết thúc -->
                <div id="finished-screen" class="text-center py-5 d-none">
                    <div class="display-4 text-success mb-3">✓</div>
                    <h3 class="fw-bold text-success mb-3">Đã hoàn thành phần thi vấn đáp!</h3>
                    <p class="text-muted mb-4">
                        Cảm ơn bạn đã hoàn thành phiên thi. Kết quả và biên bản chi tiết đã được ghi nhận vào hệ thống.
                    </p>
                    <a asp-controller="MyExams" asp-action="Index" class="btn btn-outline-primary px-4">
                        Quay về Bài thi của tôi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/pcm-player.js" asp-append-version="true"></script>
    <script>
        const participantId = @participantId;
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const startScreen = document.getElementById('start-screen');
        const examScreen = document.getElementById('exam-screen');
        const finishedScreen = document.getElementById('finished-screen');

        const btnStart = document.getElementById('btn-start');
        const btnSubmit = document.getElementById('btn-submit');
        const questionText = document.getElementById('question-text');
        const questionBadge = document.getElementById('question-badge');
        const followupBadge = document.getElementById('followup-badge');
        const ttsStatus = document.getElementById('tts-status');
        const timerBox = document.getElementById('timer-box');
        const micStatus = document.getElementById('mic-status');
        const answerBox = document.getElementById('answer-box');
        const subjectBadge = document.getElementById('subject-badge');

        let currentState = null;
        let timerInterval = null;
        let secondsRemaining = 60;
        let recognition = null;
        let isRecognizing = false;
        let pcmPlayer = new PcmPlayer(48000);
        let manualTextPrefix = '';

        // ---- Ghi âm câu trả lời (MediaRecorder): bắt đầu khi AI đọc xong, dừng khi nộp, gửi ngầm sau khi đã nhận câu tiếp theo
        let micStream = null;
        let recorder = null;
        let recordedChunks = [];

        async function startRecording() {
            if (!navigator.mediaDevices || !window.MediaRecorder) return; // trình duyệt không hỗ trợ: vẫn thi bằng STT/gõ
            try {
                micStream = micStream || await navigator.mediaDevices.getUserMedia({ audio: true });
                recordedChunks = [];
                const type = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/mp4']
                    .find(t => MediaRecorder.isTypeSupported(t));
                recorder = new MediaRecorder(micStream, type ? { mimeType: type } : undefined);
                recorder.ondataavailable = e => { if (e.data && e.data.size > 0) recordedChunks.push(e.data); };
                recorder.start(1000);
            } catch (e) {
                recorder = null; // từ chối quyền micro hoặc lỗi thiết bị: không ghi âm, buổi thi vẫn tiếp tục
            }
        }

        // Trả về Promise<Blob|null> chứa toàn bộ ghi âm của lượt vừa trả lời
        function stopRecording() {
            const r = recorder;
            recorder = null;
            if (!r || r.state === 'inactive') return Promise.resolve(null);
            return new Promise(resolve => {
                r.onstop = () => resolve(recordedChunks.length ? new Blob(recordedChunks, { type: r.mimeType || 'audio/webm' }) : null);
                r.stop();
            });
        }

        async function uploadRecording(turnId, blob) {
            if (!blob) return;
            try {
                const formData = new FormData();
                formData.append('turnId', turnId);
                formData.append('audio', blob, 'answer.webm');
                formData.append('__RequestVerificationToken', antiForgeryToken);
                const res = await fetch('/Interview/UploadRecording', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    body: formData
                });
                if (!res.ok) console.warn('Không lưu được ghi âm của lượt', turnId, res.status);
            } catch (e) {
                console.warn('Không gửi được ghi âm của lượt', turnId, e);
            }
        }

        function releaseMicrophone() {
            if (micStream) micStream.getTracks().forEach(t => t.stop());
            micStream = null;
        }

        btnStart.addEventListener('click', async () => {
            btnStart.disabled = true;
            btnStart.textContent = 'Đang vào phòng...';
            document.getElementById('start-error').classList.add('d-none');

            try {
                const formData = new FormData();
                formData.append('participantId', participantId);
                formData.append('__RequestVerificationToken', antiForgeryToken);

                const res = await fetch('/Interview/Start', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    body: formData
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.error || 'Không thể bắt đầu phỏng vấn.');
                }

                const data = await res.json();
                renderState(data);
            } catch (err) {
                document.getElementById('start-error').textContent = err.message;
                document.getElementById('start-error').classList.remove('d-none');
                btnStart.disabled = false;
                btnStart.textContent = 'Bắt đầu phỏng vấn';
            }
        });

        btnSubmit.addEventListener('click', () => {
            submitAnswer(false);
        });

        async function submitAnswer(isTimeout) {
            if (!currentState || !currentState.turnId) return;

            stopTimer();
            stopSpeechRecognition();
            pcmPlayer.stop();
            if (window.speechSynthesis) window.speechSynthesis.cancel();

            btnSubmit.disabled = true;
            btnSubmit.textContent = 'Đang nộp...';
            document.getElementById('submit-error').classList.add('d-none');

            const answer = answerBox.value.trim();
            const answeredTurnId = currentState.turnId;
            const recording = stopRecording();

            try {
                const formData = new FormData();
                formData.append('turnId', currentState.turnId);
                formData.append('answer', answer);
                formData.append('timedOut', isTimeout);
                formData.append('__RequestVerificationToken', antiForgeryToken);

                const res = await fetch('/Interview/Answer', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    body: formData
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.error || 'Lỗi khi nộp câu trả lời.');
                }

                const nextState = await res.json();
                renderState(nextState);
                // Gửi ghi âm sau khi đã hiện câu tiếp theo: không làm chậm nhịp vấn đáp
                recording.then(blob => uploadRecording(answeredTurnId, blob));
            } catch (err) {
                document.getElementById('submit-error').textContent = err.message;
                document.getElementById('submit-error').classList.remove('d-none');
                btnSubmit.disabled = false;
                btnSubmit.textContent = 'Nộp câu trả lời';
            }
        }

        function renderState(state) {
            currentState = state;
            startScreen.classList.add('d-none');

            if (state.finished) {
                examScreen.classList.add('d-none');
                finishedScreen.classList.remove('d-none');
                // Đợi bản ghi của câu cuối gửi xong (submitAnswer gọi upload ngay sau renderState) rồi mới tắt micro
                setTimeout(releaseMicrophone, 3000);
                return;
            }

            examScreen.classList.remove('d-none');
            finishedScreen.classList.add('d-none');

            subjectBadge.textContent = state.subjectCode || 'AIVES';
            questionText.textContent = state.content || '(Không có nội dung câu hỏi)';
            answerBox.value = '';
            manualTextPrefix = '';
            btnSubmit.disabled = true;
            btnSubmit.textContent = 'Nộp câu trả lời';

            // Cập nhật huy hiệu
            questionBadge.textContent = `Câu chính ${state.mainIndex}/${state.mainTotal}`;
            if (state.kind === 'FollowUp') {
                followupBadge.textContent = `Hỏi xoáy ${state.followUpIndex}/${state.followUpMax}`;
                followupBadge.classList.remove('d-none');
            } else {
                followupBadge.classList.add('d-none');
            }

            secondsRemaining = state.secondsLeft > 0 ? state.secondsLeft : (state.answerSeconds || 60);
            updateTimerDisplay();

            // Bắt đầu đọc câu hỏi bằng VieNeu-TTS hoặc Browser Speech
            playQuestionAudio(state);
        }

        async function playQuestionAudio(state) {
            ttsStatus.textContent = 'AI đang đọc câu hỏi...';
            let playedSuccessfully = false;

            try {
                // Thử phát bằng VieNeu-TTS qua POST /Interview/Speak
                const formData = new FormData();
                formData.append('turnId', state.turnId);
                formData.append('__RequestVerificationToken', antiForgeryToken);

                const res = await fetch('/Interview/Speak', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    body: formData
                });

                if (res.ok) {
                    await pcmPlayer.playStream(res, () => {
                        onQuestionSpoken(state);
                    });
                    playedSuccessfully = true;
                }
            } catch (e) {
                playedSuccessfully = false;
            }

            // Nếu VieNeu chưa chạy hoặc lỗi -> fallback qua SpeechSynthesis của trình duyệt
            if (!playedSuccessfully) {
                if ('speechSynthesis' in window && state.content) {
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance(state.content);
                    utterance.lang = state.ttsLocale || 'vi-VN';
                    utterance.onend = () => onQuestionSpoken(state);
                    utterance.onerror = () => onQuestionSpoken(state);
                    window.speechSynthesis.speak(utterance);
                } else {
                    onQuestionSpoken(state);
                }
            }
        }

        function onQuestionSpoken(state) {
            ttsStatus.textContent = 'Đã đọc xong câu hỏi. Hãy trả lời!';
            btnSubmit.disabled = false;
            startTimer();
            startRecording();
            startSpeechRecognition(state.sttLocale || 'vi-VN');
        }

        function startTimer() {
            stopTimer();
            timerInterval = setInterval(() => {
                secondsRemaining--;
                updateTimerDisplay();

                if (secondsRemaining <= 0) {
                    stopTimer();
                    submitAnswer(true);
                }
            }, 1000);
        }

        function stopTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
        }

        function updateTimerDisplay() {
            timerBox.textContent = `${secondsRemaining}s`;
            if (secondsRemaining <= 10) {
                timerBox.className = 'badge fs-5 bg-danger text-white font-monospace px-3 py-2';
            } else {
                timerBox.className = 'badge fs-5 bg-secondary text-white font-monospace px-3 py-2';
            }
        }

        function startSpeechRecognition(locale) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                micStatus.textContent = 'Trình duyệt không hỗ trợ micro (vui lòng gõ tay)';
                micStatus.className = 'badge text-bg-warning text-dark';
                return;
            }

            try {
                recognition = new SpeechRecognition();
                recognition.lang = locale;
                recognition.continuous = true;
                recognition.interimResults = true;

                recognition.onstart = () => {
                    isRecognizing = true;
                    micStatus.textContent = 'Micro đang lắng nghe...';
                    micStatus.className = 'badge text-bg-success';
                };

                recognition.onresult = (event) => {
                    let transcript = '';
                    for (let i = 0; i < event.results.length; i++) {
                        transcript += event.results[i][0].transcript;
                    }

                    if (manualTextPrefix) {
                        answerBox.value = manualTextPrefix + ' ' + transcript;
                    } else {
                        answerBox.value = transcript;
                    }
                };

                recognition.onerror = (event) => {
                    if (event.error === 'not-allowed') {
                        micStatus.textContent = 'Micro bị từ chối quyền (vui lòng gõ tay)';
                        micStatus.className = 'badge text-bg-danger';
                    }
                };

                recognition.onend = () => {
                    isRecognizing = false;
                    // Tự động bật lại nếu câu hỏi vẫn đang mở
                    if (timerInterval && !btnSubmit.disabled) {
                        manualTextPrefix = answerBox.value.trim();
                        try { recognition.start(); } catch (e) {}
                    } else {
                        micStatus.textContent = 'Micro đã dừng';
                        micStatus.className = 'badge text-bg-secondary';
                    }
                };

                recognition.start();
            } catch (e) {
                micStatus.textContent = 'Không thể kích hoạt micro';
                micStatus.className = 'badge text-bg-secondary';
            }
        }

        function stopSpeechRecognition() {
            if (recognition) {
                try { recognition.stop(); } catch (e) {}
                recognition = null;
            }
            isRecognizing = false;
            micStatus.textContent = 'Micro đã tắt';
            micStatus.className = 'badge text-bg-secondary';
        }

        // Lưu tiền tố văn bản nếu sinh viên gõ sửa bằng tay
        answerBox.addEventListener('input', () => {
            manualTextPrefix = answerBox.value;
        });
    </script>
}
