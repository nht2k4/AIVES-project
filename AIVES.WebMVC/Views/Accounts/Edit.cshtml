@model AccountEditViewModel
@{
    ViewData["Title"] = "Sửa tài khoản";
}
<a asp-action="Index" class="small">Quay lại danh sách tài khoản</a>
<h1 class="h3 mt-2 mb-1">Sửa tài khoản</h1>
<p class="text-muted mb-4">
    Trạng thái:
    @if (Model.IsActive)
    {
        <span class="badge text-bg-success">Đang hoạt động</span>
    }
    else
    {
        <span class="badge text-bg-secondary">Đã khóa</span>
    }
</p>

<div class="row g-4">
    <div class="col-lg-6">
        <form asp-action="Edit" method="post" class="card border-0 shadow-sm card-body">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsActive" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<AppRole>()" class="form-select"></select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <form asp-action="ResetPassword" method="post" class="card border-0 shadow-sm card-body">
            <h2 class="h6">Đặt lại mật khẩu</h2>
            <input type="hidden" name="id" value="@Model.Id" />
            <label for="newPassword" class="form-label small">Mật khẩu mới (ít nhất 6 ký tự)</label>
            <input type="password" id="newPassword" name="newPassword" class="form-control mb-3" required minlength="6" />
            <button type="submit" class="btn btn-outline-primary">Đặt lại mật khẩu</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
